# Copy this file to .env and fill in your values
# cp .env.example .env

# ── MongoDB Connection ──
# LOCAL development (Docker):
MONGO_URL=mongodb://localhost:27017

# PRODUCTION (MongoDB Atlas) - replace with your Atlas connection string:
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devops_task_manager?retryWrites=true&w=majority
# 
# How to get Atlas URL:
#   1. Go to https://cloud.mongodb.com
#   2. Create free cluster (M0 - Free Tier)
#   3. Click "Connect" → "Drivers" → Copy the connection string
#   4. Replace <username> and <password> with your DB user credentials

# ── JWT Secret ──
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-strong-secret

# ── CORS Allowed Origins ──
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ── AWS SES (Email Service) ──
# Required for Forgot Password functionality
AWS_REGION=ap-south-1
SES_SENDER_EMAIL=no-reply@yourdomain.com
FRONTEND_URL=http://localhost:5173
